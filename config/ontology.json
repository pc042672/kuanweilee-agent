    "explorer_campaign": {
      "type": "segment",
      "status": "active",
      "name": "Explorer Campaign",
      "description": "Target users with explorer archetype for discovery-themed campaigns",
      "conditions": [
        {
          "attribute": "archetype",
          "operator": "EQUAL",
          "value": "explorer",
          "secondValue": null,
          "minScore": 2.0
        }
      ],
      "logic": "ALL"
    },
    "high_value_female": {
      "type": "segment",
      "status": "active",
      "name": "High Value Female",
      "description": "Female members with purchasing power >= 4",
      "conditions": [
        {
          "attribute": "會員資訊-性別",
          "operator": "EQUAL",
          "value": "02",
          "secondValue": null,
          "minScore": null
        },
        {
          "attribute": "消費行為-購買力等級",
          "operator": ">=",
          "value": "4",
          "secondValue": null,
          "minScore": null
        }
      ],
      "logic": "ALL"
    },
    "dormant_reactivation": {
      "type": "segment",
      "status": "active",
      "name": "Dormant Member Reactivation",
      "description": "Members who have not purchased in 90+ days, target for win-back campaigns",
      "conditions": [
        {
          "attribute": "消費行為-購買頻率",
          "operator": "EQUAL",
          "value": "DORMANT",
          "secondValue": null,
          "minScore": null
        }
      ],
      "logic": "ALL"
    },
    "young_high_spender": {
      "type": "segment",
      "status": "active",
      "name": "Young High Spender",
      "description": "Members aged 18-34 with purchasing power >= 3, ideal for trending products",
      "conditions": [
        {
          "attribute": "會員資訊-年齡區間",
          "operator": "IN",
          "value": [
            "18-24",
            "25-34"
          ],
          "secondValue": null,
          "minScore": null
        },
        {
          "attribute": "消費行為-購買力等級",
          "operator": ">=",
          "value": "3",
          "secondValue": null,
          "minScore": null
        }
      ],
      "logic": "ALL"
    },
