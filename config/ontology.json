    "archetype": {
      "type": "attribute",
      "status": "active",
      "name": "archetype",
      "description": "Customer psychological archetype from quiz",
      "valueType": "STR",
      "isMultiple": true,
      "isScored": true,
      "options": [
        {
          "name": "Explorer",
          "value": "explorer",
          "semanticDefinition": "Driven by discovery and freedom. Seeks new experiences, variety, and adventure.",
          "metadata": null
        },
        {
          "name": "Hero",
          "value": "hero",
          "semanticDefinition": "Driven by achievement and mastery. Seeks to prove worth through courageous action.",
          "metadata": null
        },
        {
          "name": "Sage",
          "value": "sage",
          "semanticDefinition": "Driven by knowledge and truth. Seeks understanding through analysis and reflection.",
          "metadata": null
        },
        {
          "name": "Rebel",
          "value": "rebel",
          "semanticDefinition": "Driven by revolution and change. Challenges the status quo and breaks rules.",
          "metadata": null
        },
        {
          "name": "Creator",
          "value": "creator",
          "semanticDefinition": "Driven by innovation and self-expression. Seeks to build something of enduring value.",
          "metadata": null
        },
        {
          "name": "Caregiver",
          "value": "caregiver",
          "semanticDefinition": "Driven by service and compassion. Seeks to help and protect others.",
          "metadata": null
        },
        {
          "name": "Ruler",
          "value": "ruler",
          "semanticDefinition": "Driven by control and leadership. Seeks order, stability, and influence.",
          "metadata": null
        },
        {
          "name": "Magician",
          "value": "magician",
          "semanticDefinition": "Driven by transformation and vision. Seeks to make dreams come true.",
          "metadata": null
        },
        {
          "name": "Lover",
          "value": "lover",
          "semanticDefinition": "Driven by passion and connection. Seeks intimacy, beauty, and sensory pleasure.",
          "metadata": null
        },
        {
          "name": "Jester",
          "value": "jester",
          "semanticDefinition": "Driven by joy and humor. Seeks to live in the moment and have fun.",
          "metadata": null
        },
        {
          "name": "Innocent",
          "value": "innocent",
          "semanticDefinition": "Driven by optimism and simplicity. Seeks happiness and safety.",
          "metadata": null
        },
        {
          "name": "Everyman",
          "value": "everyman",
          "semanticDefinition": "Driven by belonging and connection. Seeks to fit in and be accepted.",
          "metadata": null
        }
      ]
