    "member_profile": {
      "type": "datasource",
      "status": "active",
      "name": "Member Profile",
      "table": "cdp.member_profile",
      "description": "Core member demographics and registration data",
      "primaryKey": "member_id",
      "columns": {
        "member_id": {
          "dataType": "STR",
          "description": "Unique member identifier",
          "businessTerm": null
        },
        "gender_code": {
          "dataType": "STR",
          "description": "Gender code (01=Male, 02=Female)",
          "businessTerm": null
        },
        "birth_date": {
          "dataType": "DATE",
          "description": "Member birth date",
          "businessTerm": null
        },
        "city": {
          "dataType": "STR",
          "description": "Registered city",
          "businessTerm": null
        },
        "member_level": {
          "dataType": "STR",
          "description": "Membership tier level",
          "businessTerm": null
        }
      }
    },
