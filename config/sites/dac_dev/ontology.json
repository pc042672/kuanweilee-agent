{
  "version": "3.0.0",
  "site_id": "default",
  "nodes": {
    "member_profile": {
      "type": "datasource",
      "status": "active",
      "name": "Member Profile",
      "table": "report.smb_member_info",
      "description": "One row per member with latest-order snapshot (2019-03 to 2023-07). Tenant scope: siteid = 122. Every query on this table MUST include WHERE siteid = 122; join member tables on BOTH siteid AND uid. PII columns (Member_Name, Member_Email, Member_Phone, Account, address, store_address) are excluded — never select them or use SELECT *.",
      "primaryKey": "uid",
      "columns": {
        "uid": {
          "dataType": "STR",
          "description": "Member identifier (unique within siteid)",
          "businessTerm": null
        },
        "siteid": {
          "dataType": "NUM",
          "description": "Tenant id — always 122",
          "businessTerm": null
        },
        "created_time": {
          "dataType": "DATE",
          "description": "Member record created",
          "businessTerm": null
        },
        "updated_time": {
          "dataType": "DATE",
          "description": "Member record updated",
          "businessTerm": null
        },
        "year": {
          "dataType": "NUM",
          "description": "Year of latest order",
          "businessTerm": null
        },
        "tx_id": {
          "dataType": "STR",
          "description": "Latest transaction id",
          "businessTerm": null
        },
        "store_id": {
          "dataType": "STR",
          "description": "Store of latest order",
          "businessTerm": null
        },
        "item_id": {
          "dataType": "STR",
          "description": "Item of latest order",
          "businessTerm": null
        },
        "item_name": {
          "dataType": "STR",
          "description": "Item name of latest order",
          "businessTerm": null
        },
        "num": {
          "dataType": "NUM",
          "description": "Quantity of latest order",
          "businessTerm": null
        },
        "amount": {
          "dataType": "NUM",
          "description": "Amount of latest order",
          "businessTerm": null
        },
        "payment_status": {
          "dataType": "STR",
          "description": "Latest order status: paid | 完成 | 處理中 | 出貨中",
          "businessTerm": null
        }
      }
    },
    "member_rfm": {
      "type": "datasource",
      "status": "active",
      "name": "Member RFM",
      "table": "report.smb_rfm_result",
      "description": "RFM metrics per member, snapshot 2026-01-15 (last purchase in data: 2025-08-11). Tenant scope: siteid = 122. Every query on this table MUST include WHERE siteid = 122; join member tables on BOTH siteid AND uid. R high = recency <= 244 days; F high = frequency > 1 visit/year; M high = avg_amount >= 1660. segment 0 = no purchase history (R/F/M NULL) — exclude with segment > 0. Quote upper-case columns: \"R\", \"F\", \"M\".",
      "primaryKey": "uid",
      "columns": {
        "uid": {
          "dataType": "STR",
          "description": "Member identifier (unique within siteid)",
          "businessTerm": null
        },
        "siteid": {
          "dataType": "NUM",
          "description": "Tenant id — always 122",
          "businessTerm": null
        },
        "R": {
          "dataType": "STR",
          "description": "Recency flag: 'high' | 'low'",
          "businessTerm": null
        },
        "F": {
          "dataType": "STR",
          "description": "Frequency flag: 'high' | 'low'",
          "businessTerm": null
        },
        "M": {
          "dataType": "STR",
          "description": "Monetary flag: 'high' | 'low'",
          "businessTerm": null
        },
        "segment": {
          "dataType": "NUM",
          "description": "RFM combination as R/F/M: 1=HHH 2=HLH 3=LHH 4=LLH 5=HHL 6=HLL 7=LHL 8=LLL; 0=unscored",
          "businessTerm": null
        },
        "recency": {
          "dataType": "NUM",
          "description": "Days since last purchase",
          "businessTerm": null
        },
        "frequency": {
          "dataType": "NUM",
          "description": "Visits per year",
          "businessTerm": null
        },
        "avg_amount": {
          "dataType": "NUM",
          "description": "Average order amount",
          "businessTerm": null
        },
        "lifetime_value": {
          "dataType": "NUM",
          "description": "Total spend",
          "businessTerm": null
        },
        "lifetime_visit": {
          "dataType": "NUM",
          "description": "Total visits",
          "businessTerm": null
        },
        "first_visit_time": {
          "dataType": "DATE",
          "description": "First purchase",
          "businessTerm": null
        },
        "last_time": {
          "dataType": "DATE",
          "description": "Last purchase",
          "businessTerm": null
        },
        "last_store": {
          "dataType": "STR",
          "description": "Store of last purchase",
          "businessTerm": null
        },
        "last_year_visit": {
          "dataType": "NUM",
          "description": "Visits in the last year",
          "businessTerm": null
        },
        "last_year_total_amout": {
          "dataType": "NUM",
          "description": "Spend in the last year (column name misspelled in source)",
          "businessTerm": null
        },
        "recency_bin": {
          "dataType": "NUM",
          "description": "Recency decile 1-10 (1 = most recent)",
          "businessTerm": null
        },
        "frequency_bin": {
          "dataType": "NUM",
          "description": "Frequency decile 1-10 (10 = most frequent)",
          "businessTerm": null
        },
        "avg_amount_bin": {
          "dataType": "NUM",
          "description": "Average-amount decile 1-10",
          "businessTerm": null
        }
      }
    },
    "dac_taxonomy": {
      "type": "datasource",
      "status": "active",
      "name": "DAC Taxonomy",
      "table": "dac.dac_taxonomy",
      "description": "Shared (not tenant-scoped) interest/brand label taxonomy: category, label hierarchy levels 1-5, label_type brand | retail_interest | 90_of_order.",
      "primaryKey": "id",
      "columns": {
        "id": {
          "dataType": "NUM",
          "description": "Label id",
          "businessTerm": null
        },
        "category": {
          "dataType": "STR",
          "description": "Top-level category",
          "businessTerm": null
        },
        "label_level_1": {
          "dataType": "STR",
          "description": "Hierarchy level 1",
          "businessTerm": null
        },
        "label_level_2": {
          "dataType": "STR",
          "description": "Hierarchy level 2",
          "businessTerm": null
        },
        "label_level_3": {
          "dataType": "STR",
          "description": "Hierarchy level 3",
          "businessTerm": null
        },
        "label": {
          "dataType": "STR",
          "description": "Leaf label",
          "businessTerm": null
        },
        "description": {
          "dataType": "STR",
          "description": "Label description",
          "businessTerm": null
        },
        "label_type": {
          "dataType": "STR",
          "description": "brand | retail_interest | 90_of_order",
          "businessTerm": null
        },
        "level": {
          "dataType": "NUM",
          "description": "Depth of the label",
          "businessTerm": null
        }
      }
    },
