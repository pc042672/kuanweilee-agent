    "explorer_campaign": {
      "type": "segment",
      "status": "active",
      "name": "Explorer Campaign",
      "description": "Target users with explorer archetype for discovery-themed campaigns",
      "conditions": [
        {
          "attribute": "archetype",
          "operator": "EQUAL",
          "value": "explorer",
          "secondValue": null,
          "minScore": 2.0
        }
      ],
      "logic": "ALL"
    },
