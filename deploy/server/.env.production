# AI-CDP — private-server production environment.
# Copy to the project root as .env (loaded by systemd EnvironmentFile):
#   cp deploy/server/.env.production /root/ai-cdp/.env && vim /root/ai-cdp/.env

# ─── App database (PostgreSQL 12+) ──────────────────────────────────
# Backs ADK sessions/chat history, long-term memory, and per-site config.
# Setting this switches the app from in-memory dev mode to production.
DATABASE_URL='postgresql+psycopg2://aicdp:password@localhost:5432/aicdp'

# ─── Auth (required in production) ──────────────────────────────────
JWT_SECRET='change-me-to-a-long-random-string'   # openssl rand -hex 32
GOOGLE_CLIENT_ID='your-oauth-client-id.apps.googleusercontent.com'

# ─── Analytics database (per-site Greenplum 6.22 / PostgreSQL 12) ───
# Read-only source the agent queries for customer data.
GP_HOST='your-greenplum-host'
GP_PORT='5432'
GP_USER='your-db-user'
GP_PASSWORD='your-db-password'
GP_DBNAME='your-db-name'
GP_READONLY_USER='readonly_user'        # optional; falls back to GP_USER
GP_READONLY_PASSWORD='readonly-password'

# ─── Gemini ─────────────────────────────────────────────────────────
GEMINI_API_KEY='your-gemini-api-key'

# ─── Server ─────────────────────────────────────────────────────────
# CORS origins (comma-separated). Empty = same-origin only (recommended
# when nginx serves the SPA and proxies the API on one domain).
CORS_ORIGINS=''
LOG_LEVEL='INFO'                         # DEBUG for verbose logs
